SPRING_PROFILES_ACTIVE=prod

# Local Docker Compose PostgreSQL credentials; use the same password for both variables.
POSTGRES_PASSWORD=replace-with-a-strong-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/invitation_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-strong-password

ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

GOOGLE_MAIL_USERNAME=
GOOGLE_MAIL_PASSWORD=
